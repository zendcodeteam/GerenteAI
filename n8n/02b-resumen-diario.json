{
  "name": "Luka AI · 02b · Resumen diario (21:00)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 21 * * *" }]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-220, 0],
      "id": "a2b00000-0000-4000-8000-000000000001",
      "name": "Todos los días 21:00"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL || 'https://TU-BACKEND.up.railway.app' }}/ai/recordatorios/nocturno",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 90000 }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [0, 0],
      "id": "a2b00000-0000-4000-8000-000000000002",
      "name": "Obtener resúmenes diarios",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_ID_CREDENCIAL",
          "name": "Backend Luka AI (x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const respuesta = $input.first().json;\nconst dinero = (valor) => '$' + Math.round(Number(valor) || 0).toLocaleString('es-CO');\nconst resumenes = respuesta.resumenes || [];\nconsole.log(`[Resumen diario 21:00] Resumenes a enviar: ${resumenes.length}`);\nreturn resumenes.map((d) => ({ json: { ...d, destino: `${d.negocio} (${d.sede})`, ingresos: dinero(d.ingresos), gastos: dinero(d.gastos), balance: dinero(d.balance), movimientos: String(d.movimientos || 0) } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "id": "a2b00000-0000-4000-8000-000000000003",
      "name": "Preparar resumen diario"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.WHATSAPP_API_VERSION || 'v25.0' }}/{{ $env.WHATSAPP_PHONE_NUMBER_ID || '1276800955509419' }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', ...($json.destinatario.includes('.') ? { recipient: $json.destinatario } : { to: $json.destinatario }), type: 'template', template: { name: $env.WHATSAPP_TEMPLATE_RESUMEN_DIARIO || 'resumen_diario', language: { code: $env.WHATSAPP_TEMPLATE_LANG || 'es' }, components: [{ type: 'body', parameters: [{ type: 'text', text: $json.contacto }, { type: 'text', text: $json.destino }, { type: 'text', text: $json.ingresos }, { type: 'text', text: $json.gastos }, { type: 'text', text: $json.balance }, { type: 'text', text: $json.movimientos }] }] } } }) }}",
        "options": {
          "timeout": 15000,
          "batching": { "batch": { "batchSize": 10, "batchInterval": 1000 } }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [440, 0],
      "id": "a2b00000-0000-4000-8000-000000000004",
      "name": "Enviar resumen diario",
      "credentials": {
        "httpBearerAuth": {
          "id": "Pjjumysctcj1HMVh",
          "name": "Bearer Auth account"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) console.error('[Resumen diario 21:00] ERROR de envío:', JSON.stringify(item.json).slice(0, 800));\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 140],
      "id": "a2b00000-0000-4000-8000-000000000005",
      "name": "Registrar fallos"
    }
  ],
  "connections": {
    "Todos los días 21:00": { "main": [[{ "node": "Obtener resúmenes diarios", "type": "main", "index": 0 }]] },
    "Obtener resúmenes diarios": { "main": [[{ "node": "Preparar resumen diario", "type": "main", "index": 0 }]] },
    "Preparar resumen diario": { "main": [[{ "node": "Enviar resumen diario", "type": "main", "index": 0 }]] },
    "Enviar resumen diario": { "main": [[], [{ "node": "Registrar fallos", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "executionTimeout": 600
  },
  "tags": []
}
