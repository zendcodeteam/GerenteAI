# =============================================================================
# Variables del frontend (Vite)
#
# OJO: todo lo que empiece por VITE_ queda EMBEBIDO en el bundle y es público.
# Nunca pongas secretos aquí.
#
# Este archivo es el valor por defecto para desarrollo. En Vercel hay que
# definir las mismas variables en Settings -> Environment Variables, porque el
# build de producción usa esas y no este archivo.
# =============================================================================

# URL del backend NestJS.
#   local     -> http://localhost:3000
#   en Vercel -> https://gerenteai.onrender.com
VITE_API_URL=http://localhost:3000

# Número de WhatsApp de Luka, en formato internacional y solo dígitos (+57 304 390 4488).
# A este chat se manda al usuario para interactuar con Luka y soporte.
VITE_WHATSAPP_NUMBER=573043904488

# Pasarela de pagos.
#
# Mientras esté en true (o sin definir), el checkout es una simulación y no se
# cobra nada. Ponlo en false para que los pagos salgan de verdad contra Wompi:
# el entorno lo decide el backend según las llaves que tenga (test_ o prod_),
# aquí no hay nada que cambiar entre sandbox y producción.
VITE_USE_MOCK_GATEWAY=false

# Checkout alojado de Wompi. Confirma el valor en tu panel: el de sandbox puede
# ser distinto del de producción.
VITE_WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
VITE_GOOGLE_CLIENT_ID=70842230792-g7ijn6ctg1qf38l3skehkojj78hgduvv.apps.googleusercontent.com