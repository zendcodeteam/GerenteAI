# =============================================================================
# Luka AI — configuracion del backend
# Copia este archivo como .env y ajusta los valores.
# =============================================================================

PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_ai

# Zona horaria del proceso. DEBE coincidir con la del workflow de n8n y con la
# que usan las consultas de los recordatorios; si no, "hoy" significa cosas
# distintas en cada sitio.
TZ=America/Bogota

# En "production" el backend exige N8N_API_KEY para las rutas de integracion.
NODE_ENV=development


# =============================================================================
# AUTENTICACION Y CORREO  (Backend)
# -----------------------------------------------------------------------------
# Sin JWT_SECRET la aplicacion NO ARRANCA: JwtStrategy lanza al construirse.
# Sin las SMTP_*, POST /auth/register responde 500 al intentar enviar el correo
# de verificacion, y el usuario queda creado pero sin poder iniciar sesion.
# =============================================================================

# Secreto para firmar los JWT. Generalo con: openssl rand -hex 32
JWT_SECRET=gerente-ai-local-secret-change-me

# Vigencia del token de sesion. Opcional: por defecto 1d.
JWT_EXPIRES_IN=1d

# Servidor de correo saliente. En pruebas se usa Gmail con contrasena de
# aplicacion (no la del usuario); en produccion conviene Resend o SendGrid.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=contrasena-de-aplicacion
SMTP_FROM="GerenteAI <tucorreo@gmail.com>"

# Base de los enlaces que van dentro de los correos (verificar cuenta, recuperar
# contrasena). Sin barra final.
FRONTEND_URL=http://localhost:5173

# =============================================================================
# INTEGRACION CON n8n / WHATSAPP  (Persona 5)
# -----------------------------------------------------------------------------
# n8n llama a POST /ai/interpret con la cabecera `x-api-key`.
# =============================================================================

# A donde se manda a registrar a quien le escribe a Luka desde un numero que no
# esta en ninguna sede. Va dentro del mensaje de WhatsApp, asi que debe ser una
# URL publica (no localhost). Por defecto: https://luka-gules.vercel.app/home
FRONTEND_REGISTER_URL=https://luka-gules.vercel.app/home

# Panel de la aplicacion. Ahi se manda a quien YA tiene cuenta pero todavia no
# creo su negocio: mandarlo a registrarse otra vez lo deja dando vueltas.
# Por defecto: https://luka-gules.vercel.app/
FRONTEND_APP_URL=https://luka-gules.vercel.app/

# A donde se manda a quien pide una funcion que su plan no incluye.
# Por defecto: https://luka-gules.vercel.app/subscription
FRONTEND_PLANS_URL=https://luka-gules.vercel.app/subscription

# Secreto compartido con n8n. Generalo con: openssl rand -hex 32
# Sin esto, cualquiera que conozca la URL puede gastar la cuota de IA.
N8N_API_KEY=cambia-esto-por-un-secreto-largo

# De donde lee y escribe la IA los movimientos:
#   prisma  (por defecto) → PostgreSQL real. Es lo que debe correr en produccion.
#   memory                → datos de demostracion, sin base de datos.
FINANCE_DATA_SOURCE=prisma


# =============================================================================
# PROVEEDOR DE IA
# -----------------------------------------------------------------------------
# Cambiar de IA = cambiar AI_PROVIDER y su llave. Ninguna otra linea de codigo
# se toca. Opciones: groq | gemini | openrouter | ollama | anthropic | openai |
#                    deepseek | echo
# =============================================================================

# --- Opcion 0: sin configurar nada (arranca y responde, pero simulado) -------
AI_PROVIDER=echo

# --- Opcion 1 (recomendada para pruebas): Groq — gratis y muy rapido ---------
# Llave gratuita en https://console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile

# --- Opcion 2: Google Gemini — gratis, mejor espanol y JSON con esquema ------
# Llave gratuita en https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# AI_MODEL=gemini-3.6-flash
#
# Sobre el modelo: los Gemini 3.x razonan antes de responder. El backend les
# manda el nivel de pensamiento segun el "effort" de cada caso de uso (para
# interpretar un mensaje de WhatsApp es "low"), asi que contestan rapido.
# gemini-3.7-flash esta soportado, pero al 28/08/2026 Google devuelve 503
# "high demand" casi siempre y, cuando responde, tarda ~30 s. Conviene 3.6
# hasta que se estabilice: responde en 1-2 s.

# --- Opcion 3: Ollama — 100% local, costo cero, datos que no salen del equipo -
# Requiere `ollama serve` y `ollama pull llama3.1:8b`
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1:8b
# AI_BASE_URL=http://localhost:11434/v1

# --- Opcion 4 (produccion): Anthropic / Claude — de pago --------------------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# Modelos mas economicos: claude-sonnet-5 | claude-haiku-4-5


# --- Proveedor de respaldo (opcional) ----------------------------------------
# Si el principal falla por saturacion o caida, se usa este automaticamente.
# AI_FALLBACK_PROVIDER=groq
# AI_FALLBACK_API_KEY=gsk_...
# AI_FALLBACK_MODEL=llama-3.1-8b-instant


# --- Ajustes comunes ---------------------------------------------------------
# Tope general: lo que corre solo (informes, recomendaciones del panel).
AI_TIMEOUT_MS=45000

# Tope cuando hay alguien esperando la respuesta (WhatsApp, chat de la landing).
# Mas corto a proposito: a los 45 segundos el usuario ya se fue a otra cosa, y
# con reintentos encima el plazo se multiplica.
AI_TIMEOUT_INTERACTIVE_MS=20000
AI_MAX_RETRIES=3
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.2

# Registra prompts y respuestas completas en los logs.
# Dejar en false: contienen datos financieros de los clientes.
AI_LOG_PROMPTS=false

# Solo Anthropic: si los clasificadores rechazan una peticion, el API la
# reintenta en otro modelo de Anthropic en la misma llamada.
ANTHROPIC_SERVER_FALLBACK=true
